[Unit]
Description=PocoBox Local SLM Service (llama-server Qwen2.5-0.5B)
After=network.target

[Service]
Type=simple
User=user
Group=user
CPUAffinity=4-7
MemoryMax=800M
ExecStart=/usr/bin/llama-server -m /srv/pocobox/models/qwen2.5-0.5b-instruct-q4_k_m.gguf --device none --no-op-offload --host 127.0.0.1 --port 8767 -c 1024 -t 4 --parallel 1 --temp 0.0 --no-warmup
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
