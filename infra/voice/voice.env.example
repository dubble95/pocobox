# PocoBox Always-On Hybrid Voice Control Configuration
# Copy to /etc/pocobox/voice.env on pocobox and fill in ONE cloud API key.

# Provider: auto | gemini | openai | local
VOICE_PROVIDER=auto

# Option 1 (Recommended — single-shot audio->JSON intent with Gemini 3.1 Flash-Lite):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Option 2 (OpenAI Transcribe + fast local rule / GPT-4o-mini):
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_CHAT_MODEL=gpt-4o-mini

# Always-on hands-free listening
CONTINUOUS_LISTEN=1
REQUIRE_WAKE_WORD=1

# LMS connection
LMS_HOST=127.0.0.1
LMS_PORT=9000
PLAYER_NAME=pocobox

# HTTP control & Now-Playing Display UI
VOICE_HTTP_HOST=0.0.0.0
VOICE_HTTP_PORT=8765

# Microphone & VAD tuning
VOICE_MAX_SEC=7.0
VOICE_SILENCE_SEC=1.0
VOICE_PREROLL_SEC=0.5
VOICE_ONSET_SEC=0.2
VOICE_VAD_THRESHOLD=45.0
VOICE_VAD_MULTIPLIER=3.5
VOICE_COOLDOWN_SEC=1.5
ENABLE_CHIME=1

# Hardware trigger: hold Volume-Up >= 0.7s to force-listen (no wake word required)
ENABLE_HW_BUTTON=1
HW_BUTTON_DEVICE=/dev/input/event2
HW_BUTTON_HOLD_SEC=0.7
