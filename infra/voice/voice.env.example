# PocoBox Always-On Hybrid Voice Control Configuration
# Copy to /etc/pocobox/voice.env on pocobox and fill in ONE cloud API key.

# Provider: auto | gemini | openai | local
VOICE_PROVIDER=auto

# Local-First On-Device STT (SenseVoice-Small INT8 via pocobox-stt Docker container, ~0.2-0.3s, free/offline)
LOCAL_STT_URL=http://127.0.0.1:8766
LOCAL_STT_LANGUAGE=ko
LOCAL_STT_TIMEOUT=5.0
# Escalate unrecognized utterances / general Q&A (text-only) to cloud LLM when an API key is configured
VOICE_CLOUD_FALLBACK=1

# Option 1 (Recommended — single-shot audio->JSON intent with Gemini 3.1 Flash-Lite):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Option 2 (OpenAI Transcribe + fast local rule / GPT-4o-mini):
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_CHAT_MODEL=gpt-4o-mini

# Always-on hands-free listening
CONTINUOUS_LISTEN=1
REQUIRE_WAKE_WORD=1

# LMS connection
LMS_HOST=127.0.0.1
LMS_PORT=9000
PLAYER_NAME=pocobox
# Automatically enable TIDAL Track Radio + LMS Don't Stop The Music (PLUGIN_TIDAL_DSTM) after single-track playback
ENABLE_TIDAL_AUTOPLAY=1

# HTTP control & Now-Playing Display UI
VOICE_HTTP_HOST=0.0.0.0
VOICE_HTTP_PORT=8765

# Microphone DSP, Decoupled WebRTC AEC3, Local Wake-Word, Auto-Ducking & VAD tuning
VOICE_MIC_CHANNEL=right
VOICE_USE_AEC3=1
VOICE_AEC3_DELAY_MS=60
VOICE_VIS_SHM=/squeezelite-02:70:6f:63:6f:01
VOICE_USE_RNNOISE=1
VOICE_RNNOISE_ON_WAKE=0
VOICE_USE_BANDPASS=1
VOICE_BANDPASS_LOW_HZ=150
VOICE_BANDPASS_HIGH_HZ=6000
VOICE_WAKE_ENGINE=vosk
VOSK_WAKE_MODEL_DIR=/srv/pocobox/models/vosk-model-small-en-us-0.15
VOICE_WAKE_CONFIRM_CHUNKS=3
VOICE_WAKE_QUIET_CONFIRM_CHUNKS=2
VOICE_WAKE_MIN_CONF=0.72
VOICE_WAKE_QUIET_MIN_CONF=0.60
VOICE_WAKE_MIN_RMS=55.0
VOICE_WAKE_SNR_RATIO=1.25
VOICE_RMS_FALLBACK_DURING_MUSIC=0
VOICE_TELEMETRY_ENABLED=1
VOICE_TELEMETRY_LOG=/srv/pocobox/logs/voice_telemetry.jsonl
VOICE_SAVE_WAKE_CLIPS=1
VOICE_WAKE_CLIPS_DIR=/srv/pocobox/logs/wake_clips
VOICE_WAKE_CLIP_MAX_FILES=200
VOICE_DUCK_ENABLED=1
VOICE_DUCK_VOLUME=18

VOICE_MAX_SEC=5.0
VOICE_WAKE_MAX_SEC=4.8
VOICE_WAKE_TIMEOUT_SEC=3.5
VOICE_SILENCE_SEC=0.9
VOICE_WAKE_SILENCE_SEC=0.7
VOICE_PREROLL_SEC=0.5
VOICE_ONSET_SEC=0.2
VOICE_VAD_THRESHOLD=40.0
VOICE_VAD_MULTIPLIER=3.0
VOICE_PLAYING_VAD_THRESHOLD=180.0
VOICE_PLAYING_MULTIPLIER=2.1
VOICE_COOLDOWN_SEC=1.8
ENABLE_CHIME=1
VOICE_CHIME_VOLUME=0.25
ENABLE_TTS=1
ENABLE_COMMAND_ACK=1
# Optional English voice override for mixed Korean/English TTS (blank auto-pairs with TTS_VOICE)
TTS_EN_VOICE=
# Leave empty to auto-route chimes & TTS strictly to POCO F1 built-in Speaker sink (never USB DAC/Headphones)
VOICE_SPEAKER_SINK=

# Hardware trigger: hold Volume-Up >= 0.7s to force-listen (no wake word required)
ENABLE_HW_BUTTON=1
HW_BUTTON_DEVICE=/dev/input/event2
HW_BUTTON_HOLD_SEC=0.7

# Kids/Beginner English Listening Quiz (bilingual Korean narration + native English TTS)
QUIZ_EN_VOICE=en-US-JennyNeural
QUIZ_EN_RATE_PCT=-8
QUIZ_LISTEN_MAX_SEC=7.0
QUIZ_SILENCE_SEC=1.2
QUIZ_USE_LLM_GENERATION=0
# Scheduled daily 07:45 KST quiz defaults (triggered by pocobox-daily-quiz.timer)
DAILY_QUIZ_TOPIC=all
DAILY_QUIZ_COUNT=3

# Default device location for live KMA weather & location-aware Q&A (defaults to Bundang / 성남시 분당구)
POCOBOX_LOCATION_NAME=분당
POCOBOX_WEATHER_ZONE=4113551000
