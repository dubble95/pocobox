# PocoBox Hybrid Voice Control Configuration
# Copy to /etc/pocobox/voice.env on pocobox and fill in ONE cloud API key for audio STT+Intent.

# Provider: auto | gemini | openai | local
VOICE_PROVIDER=auto

# Option 1 (Recommended — single-shot audio->JSON intent, ~1s latency):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Option 2 (OpenAI Whisper/Transcribe + fast local rule / GPT-4o-mini):
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_CHAT_MODEL=gpt-4o-mini

# LMS connection
LMS_HOST=127.0.0.1
LMS_PORT=9000
PLAYER_NAME=pocobox

# HTTP control API
VOICE_HTTP_HOST=0.0.0.0
VOICE_HTTP_PORT=8765

# Microphone & VAD tuning
VOICE_MAX_SEC=8.0
VOICE_SILENCE_SEC=1.2
VOICE_VAD_THRESHOLD=350.0
ENABLE_CHIME=1

# Hardware trigger: hold Volume-Up >= 0.7s to start listening
ENABLE_HW_BUTTON=1
HW_BUTTON_DEVICE=/dev/input/event2
HW_BUTTON_HOLD_SEC=0.7
