[Unit]
Description=PocoBox USB DAC Hotplug, WebRTC AEC & Auto-Play Daemon
After=network-online.target docker.service pocobox-pulseaudio.service pocobox-squeezelite.service sound.target
Wants=pocobox-pulseaudio.service pocobox-squeezelite.service

[Service]
Type=simple
EnvironmentFile=-/etc/pocobox/dac-autoplay.env
ExecStart=/usr/bin/python3 /srv/pocobox/bin/pocobox_dac_autoplay.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
