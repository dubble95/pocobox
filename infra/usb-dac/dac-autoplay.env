# PocoBox USB DAC Auto-Play configuration
LMS_HOST=127.0.0.1
LMS_PORT=9000
PLAYER_NAME=pocobox
PLAYER_MAC=02:70:6f:63:6f:01

# Enable PulseAudio WebRTC Acoustic Echo Cancellation (AEC)
# 0 = Direct ALSA bit-perfect output (RECOMMENDED on POCO F1: avoids snd_soc_sdm845 capture timestamp skew dropping sink audio)
# 1 = Experimental PulseAudio WebRTC AEC
ENABLE_AEC=0
AEC_SINK_NAME=pocobox_aec_sink
AEC_SOURCE_NAME=pocobox_aec_mic

# ALSA output prefix when ENABLE_AEC=0:
# hw:CARD={card_id},DEV=0 = true bit-perfect direct hardware ALSA (bypasses ALSA plug/resampler)
DAC_OUTPUT_TEMPLATE=hw:CARD={card_id},DEV=0

# Squeezelite extra flags when USB DAC is active vs fallback PulseAudio
# -R -u vLE: SoXR VHQ linear-phase in Exception mode (100% bit-perfect bypass for native DAC rates;
#            clean synchronous 28-bit VHQ resampling only when track rate exceeds DAC hardware support).
# Note: pocobox-dac-autoplay automatically appends -v (VISEXPORT shm reference for decoupled AEC3)
# whenever the installed squeezelite binary was compiled with -DVISEXPORT.
DAC_SQUEEZELITE_EXTRA_ARGS=-m 02:70:6f:63:6f:01 -p 95 -a 80:4::1 -C 5 -W -R -u vLE
FALLBACK_OUTPUT=pulse
FALLBACK_SQUEEZELITE_EXTRA_ARGS=-m 02:70:6f:63:6f:01 -C 5 -W -R -u hLE

# USB DAC volume behavior:
# DAC_FORCE_HW_FULL_VOLUME=1 locks USB DAC ALSA hardware playback mixer to 100% (0.00 dB) & unmuted.
# DAC_ATTACH_LMS_VOLUME=100 sets LMS player volume to 100% (unity gain = bit-perfect) on DAC attach.
# DAC_LMS_FIXED_VOLUME=1 strictly locks LMS output at fixed 100% (digitalVolumeControl=0) to prevent
# any bit-depth degradation; software volume control and auto-ducking are disabled in DAC mode.
DAC_FORCE_HW_FULL_VOLUME=1
DAC_ATTACH_LMS_VOLUME=100
DAC_LMS_FIXED_VOLUME=1

# Auto-play behavior when USB DAC is plugged in:
# 1 = resume existing LMS queue; if empty, play TIDAL My Mix (when FALLBACK_TIDAL_MIX=1)
AUTOPLAY_ON_ATTACH=1
FALLBACK_TIDAL_MIX=1
PAUSE_ON_DETACH=1
DEBOUNCE_SECONDS=1.5
