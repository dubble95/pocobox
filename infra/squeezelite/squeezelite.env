# PocoBox Squeezelite runtime configuration
# Phase 1 default: PulseAudio (built-in speaker / 3.5mm / Bluetooth)
# Phase 2 USB DAC hotplug will switch SQUEEZELITE_OUTPUT to hw:CARD=<DAC_NAME>
SQUEEZELITE_NAME=pocobox
SQUEEZELITE_SERVER=127.0.0.1
SQUEEZELITE_OUTPUT=pulse
SQUEEZELITE_EXTRA_ARGS=-m 02:70:6f:63:6f:01 -C 5 -W -R -u hLE
