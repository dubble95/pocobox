[Unit]
Description=PocoBox Squeezelite Audio Player
After=network-online.target docker.service sound.target
Wants=network-online.target

[Service]
Type=simple
User=user
Group=audio
Environment=XDG_RUNTIME_DIR=/run/user/10000
Environment=PULSE_SERVER=unix:/run/user/10000/pulse/native
EnvironmentFile=/etc/pocobox/squeezelite.env
ExecStart=/bin/sh -c 'exec /usr/local/bin/squeezelite -n "${SQUEEZELITE_NAME}" -s "${SQUEEZELITE_SERVER}" -o "${SQUEEZELITE_OUTPUT}" ${SQUEEZELITE_EXTRA_ARGS}'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
