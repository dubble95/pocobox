# PocoBox Display settings
DISPLAY_URL=http://127.0.0.1:8765/display?kiosk=1
# Backlight brightness (0..4095 on POCO F1; 1800 ~= 44% indoor vivid)
DISPLAY_BRIGHTNESS=1800
# Display power mode: auto (turn off backlight when music is not playing) | always_on
DISPLAY_POWER_MODE=auto
# Seconds to wait after music stops/pauses before turning off the backlight
DISPLAY_IDLE_OFF_SEC=10
# Seconds to keep the screen awake after a touchscreen tap or hardware key press while idle
DISPLAY_TOUCH_WAKE_SEC=15
# CSS DPI scale for 1080x2246 6.18" screen (2.5 -> 432x898 logical px)
FIREFOX_SCALE=2.5
# Screen rotation: auto (accelerometer via iio-sensor-proxy), or fixed normal|90|180|270
DISPLAY_ROTATION=auto
