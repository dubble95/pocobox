[Unit]
Description=PocoBox Smart Backlight Controller (Auto-Off When Idle)
After=greetd.service pocobox-voice.service
Wants=pocobox-voice.service

[Service]
Type=simple
EnvironmentFile=-/etc/pocobox/display.env
ExecStart=/usr/bin/python3 /srv/pocobox/bin/pocobox-backlight.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
